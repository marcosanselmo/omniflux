# ==============================================================================
# OMNIFLUX - AMBIENTE DE CONFIGURAÇÃO (.env.example)
# Copie este arquivo para .env no ambiente de desenvolvimento: cp .env.example .env
# NUNCA commite arquivos .env ou valores reais de produção no controle de versão!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLICAÇÃO NEXT.JS & SERVIDOR
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="OmniFlux"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO (NEXTAUTH / AUTH.JS)
# ------------------------------------------------------------------------------
# Em produção, gere uma chave criptograficamente segura: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. BANCO DE DADOS (POSTGRESQL 16+)
# ------------------------------------------------------------------------------
# Parâmetros individuais (usados pelo docker-compose)
POSTGRES_USER="omniflux"
POSTGRES_PASSWORD="omniflux_dev_password"
POSTGRES_DB="omniflux_db"
POSTGRES_PORT=5432

# Connection string consumida pelo Prisma ORM
DATABASE_URL="postgresql://omniflux:omniflux_dev_password@localhost:5432/omniflux_db?schema=public"

# ------------------------------------------------------------------------------
# 4. ARMAZENAMENTO DE ARQUIVOS (API S3 / MINIO LOCAL)
# ------------------------------------------------------------------------------
# Para Docker Compose local, aponte para o serviço minio
S3_ENDPOINT="localhost"
S3_PORT=9000
S3_USE_SSL=false
S3_REGION="us-east-1"
S3_ACCESS_KEY="omniflux_minio_admin"
S3_SECRET_KEY="omniflux_minio_secret"
S3_BUCKET_NAME="omniflux-media"
# URL pública para download/visualização de comprovantes homologados
S3_PUBLIC_URL="http://localhost:9000/omniflux-media"

# ------------------------------------------------------------------------------
# 5. LIMITES OPERACIONAIS DE UPLOAD & ARQUIVOS
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=15
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# ------------------------------------------------------------------------------
# 6. BOOTSTRAP INICIAL DO SISTEMA (SEED ADMIN)
# ------------------------------------------------------------------------------
# Credenciais usadas exclusivamente no primeiro seed para criar o ADMIN_GERAL
INITIAL_ADMIN_NAME="Administrador Geral"
INITIAL_ADMIN_EMAIL="admin@omniflux.local"
INITIAL_ADMIN_PASSWORD="AdminSecurePassword123!"
