// ==============================================================================
// OMNIFLUX - SCHEMA PRISMA ORM (POSTGRESQL 16+)
// Arquitetura: Single-Tenant (Self-Hosted)
// Governança: snake_case no banco via @@map/@map, UUID v4 e índices explícitos
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS DE DOMÍNIO
// ------------------------------------------------------------------------------

enum GlobalRole {
  ADMIN_GERAL
  USUARIO

  @@map("global_roles")
}

enum SectorRole {
  SOLICITANTE
  EXECUTOR
  HOMOLOGADOR

  @@map("sector_roles")
}

enum TicketStatus {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_HOMOLOGACAO
  HOMOLOGADO_FECHADO
  RECUSADO_REABERTO

  @@map("ticket_statuses")
}

enum TicketPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE

  @@map("ticket_priorities")
}

enum ProofType {
  IMAGE
  DOCUMENT
  ALL

  @@map("proof_types")
}

enum AttachmentStage {
  CRIACAO
  EXECUCAO
  HOMOLOGACAO

  @@map("attachment_stages")
}

enum NotificationType {
  TICKET_CREATED
  TICKET_ASSIGNED
  HOMOLOGATION_REQUESTED
  TICKET_APPROVED
  TICKET_REJECTED

  @@map("notification_types")
}

// ------------------------------------------------------------------------------
// TABELAS E MODELOS
// ------------------------------------------------------------------------------

/// Tabela de Usuários do Sistema
model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(500)
  globalRole   GlobalRole @default(USUARIO) @map("global_role")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relacionamentos
  sectorRoles      UserSectorRole[]
  requestedTickets Ticket[]           @relation("TicketRequester")
  executedTickets  Ticket[]           @relation("TicketExecutor")
  historyEntries   TicketHistory[]
  attachments      TicketAttachment[]
  notifications    Notification[]

  @@map("users")
}

/// Tabela de Setores Parametrizáveis
model Sector {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @db.VarChar(100)
  slug              String    @unique @db.VarChar(100)
  description       String?   @db.Text
  isFinancial       Boolean   @default(false) @map("is_financial")
  requiresProofFile Boolean   @default(false) @map("requires_proof_file")
  allowedProofTypes ProofType @default(ALL) @map("allowed_proof_types")
  isRestricted      Boolean   @default(false) @map("is_restricted")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relacionamentos
  sectorRoles UserSectorRole[]
  tickets     Ticket[]

  @@map("sectors")
}

/// Matriz de Acesso RBAC por Setor
model UserSectorRole {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  sectorId  String     @map("sector_id") @db.Uuid
  role      SectorRole
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  // Relacionamentos
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([userId, sectorId, role])
  @@index([userId])
  @@index([sectorId])
  @@map("user_sector_roles")
}

/// Chamados / Tickets Internos do Sistema
model Ticket {
  id           String         @id @default(uuid()) @db.Uuid
  ticketNumber Int            @default(autoincrement()) @unique @map("ticket_number")
  title        String         @db.VarChar(200)
  description  String         @db.Text
  status       TicketStatus   @default(ABERTO)
  priority     TicketPriority @default(MEDIA)
  sectorId     String         @map("sector_id") @db.Uuid
  requesterId  String         @map("requester_id") @db.Uuid
  executorId   String?        @map("executor_id") @db.Uuid
  amount       Decimal?       @db.Decimal(12, 2)
  dueDate      DateTime?      @map("due_date")
  closedAt     DateTime?      @map("closed_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relacionamentos
  sector        Sector             @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  requester     User               @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  executor      User?              @relation("TicketExecutor", fields: [executorId], references: [id], onDelete: SetNull)
  history       TicketHistory[]
  attachments   TicketAttachment[]
  notifications Notification[]

  @@index([sectorId])
  @@index([requesterId])
  @@index([executorId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

/// Trilha Imutável de Auditoria e Transições de Estado do Chamado
model TicketHistory {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus  @map("to_status")
  reason     String?       @db.Text
  comment    String?       @db.Text
  metadata   Json?         @map("metadata")
  createdAt  DateTime      @default(now()) @map("created_at")

  // Relacionamentos
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@map("ticket_history")
}

/// Metadados de Arquivos e Comprovantes Vinculados ao Storage S3
model TicketAttachment {
  id         String          @id @default(uuid()) @db.Uuid
  ticketId   String          @map("ticket_id") @db.Uuid
  uploaderId String          @map("uploader_id") @db.Uuid
  fileName   String          @map("file_name") @db.VarChar(255)
  fileKey    String          @unique @map("file_key") @db.VarChar(500)
  mimeType   String          @map("mime_type") @db.VarChar(100)
  fileSize   Int             @map("file_size")
  stage      AttachmentStage @default(CRIACAO)
  createdAt  DateTime        @default(now()) @map("created_at")

  // Relacionamentos
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([uploaderId])
  @@index([stage])
  @@map("ticket_attachments")
}

/// Notificações Internas e Alertas de Transição de Estado
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  ticketId  String?          @map("ticket_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relacionamentos
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticketId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

